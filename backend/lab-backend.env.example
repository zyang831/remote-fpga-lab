# Copy to backend/lab-backend.env (mode 600, never commit). Used by backend/lab-backend.service.
MENDER_URL=https://<your-mender-server-host>
MENDER_USER=<mender admin account email>
MENDER_PASS=<mender admin password>
DEVICE_ID=<id of the board in Mender: Devices page or API>
# Optional overrides: BOARD_SSH=terasic@<board host>, SESSION_SECONDS, MAX_RBF_BYTES, BOARD_STREAM_URL
