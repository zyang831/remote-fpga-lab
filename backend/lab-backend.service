# Remote FPGA lab backend on :8000. Install (once):
#   sudo cp lab-backend.service /etc/systemd/system/ && sudo systemctl daemon-reload
#   sudo systemctl enable --now lab-backend
# Secrets live in lab-backend.env next to this file (mode 600, not in git):
#   MENDER_URL=... MENDER_USER=... MENDER_PASS=... DEVICE_ID=...
# ~/edge-ai-demo/artifacts/reset.sh stops/starts it (queue is in memory, wiped).
[Unit]
Description=Remote FPGA lab backend (uvicorn :8000)
After=network-online.target
Wants=network-online.target

[Service]
User=fyp-student
WorkingDirectory=/home/fyp-student/mender/lab-backend
EnvironmentFile=/home/fyp-student/mender/lab-backend/lab-backend.env
Environment=PATH=/home/fyp-student/.local/bin:/usr/local/bin:/usr/bin:/bin
# Open browser tabs hold SSE streams; without the timeout a stop waits on them forever.
ExecStart=/home/fyp-student/mender/lab-backend/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --timeout-graceful-shutdown 3
Restart=on-failure
RestartSec=3
StandardOutput=append:/home/fyp-student/mender/lab-backend/uvicorn.log
StandardError=inherit

[Install]
WantedBy=multi-user.target
